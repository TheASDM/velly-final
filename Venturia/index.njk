---
title: Campaign Wiki
description: The mobile-first wiki hub for Venturia - people, places, factions, maps, lore, and the fog at the city's edge.
published: true
date: 2026-05-23T00:00:00.000Z
editor: markdown
dateCreated: 2026-02-27T00:00:00.000Z
autoIndex: false
---

<style>
.vos-wiki-hub {
  display: grid;
  gap: 0.85rem;
}
.vos-wiki-top {
  display: grid;
  grid-template-columns: minmax(0, 0.8fr) minmax(280px, 1.2fr);
  gap: 0.85rem;
  align-items: center;
}
.vos-wiki-top h1 {
  margin: 0;
  padding: 0;
  border: 0;
  color: var(--vos-gold-bright);
  font-family: 'Cinzel', Georgia, serif;
  font-size: clamp(1.5rem, 3vw, 2.05rem);
  letter-spacing: 0.05em;
  line-height: 1.05;
}
.vos-wiki-top h1::after { content: none; }
.vos-wiki-search-inline .pagefind-ui,
.vos-wiki-search-inline .pagefind-ui__form {
  margin: 0 !important;
}
.vos-wiki-search-inline .pagefind-ui__drawer {
  position: static !important;
  max-height: none !important;
  margin-top: 0.55rem !important;
  border: 1px solid rgba(201, 161, 74, 0.18);
  border-radius: 8px;
  background: rgba(8, 7, 11, 0.7);
}
.vos-wiki-category-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.55rem;
}
.vos-wiki-category-count {
  display: inline-block;
  margin-left: 0.45rem;
  font-size: 0.7rem;
  font-variant-numeric: tabular-nums;
  opacity: 0.55;
}
.vos-wiki-category {
  display: flex;
  align-items: center;
  min-height: 48px;
  padding: 0.75rem 0.85rem;
  border: 1px solid rgba(212, 165, 116, 0.18);
  border-radius: 8px;
  background: rgba(8, 7, 11, 0.5);
  color: rgba(232, 220, 200, 0.94);
  font-family: 'Cinzel', Georgia, serif;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-decoration: none;
  text-transform: uppercase;
}
.vos-wiki-category:hover {
  color: var(--vos-cream);
  border-color: rgba(212, 165, 116, 0.5);
  background: rgba(212, 165, 116, 0.08);
  border-bottom-color: rgba(212, 165, 116, 0.5);
}
.vos-wiki-contribute {
  grid-column: 1 / -1;
  justify-content: center;
  border-color: rgba(123, 183, 173, 0.52);
  background:
    linear-gradient(180deg, rgba(123, 183, 173, 0.18), rgba(123, 183, 173, 0.06)),
    rgba(8, 7, 11, 0.72);
  color: #cdece8;
}
.vos-wiki-contribute:hover {
  border-color: rgba(123, 183, 173, 0.78);
  background: rgba(123, 183, 173, 0.14);
}
@media (max-width: 720px) {
  .vos-wiki-top,
  .vos-wiki-category-grid {
    grid-template-columns: 1fr;
  }
}
</style>

<div class="vos-wiki-hub">
  <section class="vos-wiki-top" aria-labelledby="vos-wiki-title">
    <h1 id="vos-wiki-title">Campaign Wiki</h1>
    <div class="vos-wiki-search-inline" id="vos-wiki-search"></div>
  </section>

  {#- The section list is derived from the pages themselves. Hand-listing it is
      how Creatures grew to sixty-two pages without ever appearing here. -#}
  <section class="vos-wiki-category-grid" aria-label="Wiki categories">
    {%- for section in collections.all | wikiSections -%}
    <a class="vos-wiki-category" href="{{ section.url }}">
      {{ section.title }}<span class="vos-wiki-category-count">{{ section.count }}</span>
    </a>
    {%- endfor -%}
    <a class="vos-wiki-category" href="/en/tags/">Tags</a>
    <a class="vos-wiki-category" href="/en/Archive/">All Posts</a>
    <a class="vos-wiki-category vos-wiki-contribute" href="/submit-lore/">Contribute Lore</a>
  </section>
</div>
