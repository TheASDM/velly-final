<div class="vos-rsvp-control"{% if rsvpEventId %} data-event-id="{{ rsvpEventId }}"{% endif %}>
  <div class="vos-rsvp-segmented" role="radiogroup" aria-label="RSVP status">
    <button class="vos-rsvp-segment" type="button" role="radio" aria-checked="false" data-status="going">Going</button>
    <button class="vos-rsvp-segment" type="button" role="radio" aria-checked="false" data-status="maybe">Maybe</button>
    <button class="vos-rsvp-segment" type="button" role="radio" aria-checked="false" data-status="out">Out</button>
  </div>
  <div class="vos-rsvp-status" role="status" aria-live="polite"></div>
</div>
