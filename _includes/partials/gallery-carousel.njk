<link href="/css/gallery-carousel.css" rel="stylesheet">

<div class="vos-gallery-carousel"
     data-api-base="{{ carouselApiBase | default('') }}"
     data-limit="{{ carouselLimit | default(5) }}"
     data-source="{{ carouselSource | default('recent') }}"
     data-empty-message="{{ carouselEmptyMessage | default('The shared gallery is empty. New studio pieces will appear here automatically.') }}"
     data-empty-signed-out="{{ carouselEmptySignedOut | default('Log in and heart some images in the Studio to feature them here.') }}"
     aria-label="{{ carouselLabel | default('Shared gallery carousel') }}">
  <div class="vos-gallery-carousel-viewport" tabindex="0">
    <div class="vos-gallery-carousel-track"></div>
  </div>
  <button class="vos-gallery-carousel-btn vos-gallery-carousel-prev" type="button" aria-label="Previous gallery image">&lsaquo;</button>
  <button class="vos-gallery-carousel-btn vos-gallery-carousel-next" type="button" aria-label="Next gallery image">&rsaquo;</button>
  <div class="vos-gallery-carousel-dots" aria-label="Gallery slide selector"></div>
  <div class="vos-gallery-carousel-empty" hidden></div>
</div>

<script src="/js/gallery-carousel.js" defer></script>
