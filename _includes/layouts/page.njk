<script src="/pagefind/pagefind-ui.js"></script>
<script>
window.addEventListener('DOMContentLoaded', () => {
  if (typeof PagefindUI === 'undefined') return;
  new PagefindUI({
    element: '#vos-search',
    showImages: false,
    showSubResults: true,
    resetStyles: false,
    placeholder: 'Search the codex…',
  });
