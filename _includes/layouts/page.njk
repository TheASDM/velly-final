</script>

<!-- ── Sidebar tree builder ───────────────────────────────────────────
     Builds the grouped sidebar from the flat sitemap.json. Nav groups
     are hard-coded below; each group references one or more sitemap
     subtrees (or external links). State persists per-user in
     localStorage under `vosNavOpen`. The current page's group + section
     auto-expand so context is always visible. -->
<script>
(function () {
  const here = location.pathname.replace(/\/$/, '');
  const STORE = 'vosNavOpen';

  const NAV_GROUPS = [
    {
      id: 'campaign',
      label: 'Our Campaign',
      defaultOpen: true,
      // Venturia's subdirectories surfaced directly here (no intermediate
      // "Valley of Shadows" wrapper). Creatures + College-of-the-Masquerade-Bard
      // live under Player Resources, so they're not listed here.
      children: [
        { kind: 'tree', slug: 'Venturia/Characters',  title: 'Characters' },
        { kind: 'tree', slug: 'Venturia/Culture',     title: 'Culture' },
        { kind: 'tree', slug: 'Venturia/Factions',    title: 'Factions' },
        { kind: 'tree', slug: 'Venturia/Government',  title: 'Government' },
        { kind: 'tree', slug: 'Venturia/Locations',   title: 'Locations' },
        { kind: 'tree', slug: 'Venturia/Lore',        title: 'Lore' },
        { kind: 'tree', slug: 'Venturia/Maps',        title: 'Maps' },
        { kind: 'tree', slug: 'Session-Chronicles',   title: 'Session Chronicles' }
      ]
    },
    {
      id: 'resources',
      label: 'Player Resources',
      defaultOpen: false,
      children: [
        { kind: 'tree', slug: 'Updates', title: 'Campaign Updates' },
        { kind: 'tree', slug: 'Articles', title: 'Articles & Guides' },
        { kind: 'tree', slug: 'House-Rules', title: 'House Rules' },
        { kind: 'tree', slug: 'Class-Changes', title: 'Class Changes' },
        { kind: 'tree', slug: 'Venturia/Creatures', title: 'Bestiary (5e Creatures)' },
        { kind: 'tree', slug: 'Venturia/College-of-the-Masquerade-Bard', title: 'Masquerade Bard College' }
      ]
    },
    {
      id: 'tools',
      label: 'Tools',
      defaultOpen: false,
      children: [
        { kind: 'internal', url: '/en/Tools/art/', title: 'Art Studio' },
        { kind: 'internal', url: '/enzo/', title: 'Enzo' },
        { kind: 'external', url: 'https://reference.valleyofshadows.wiki/enzo/', title: 'Using Enzo' }
      ]
    }
  ];

  function loadOpen() {
    try { return JSON.parse(localStorage.getItem(STORE)) || {}; } catch (e) { return {}; }
  }
  function saveOpen(state) {
    try { localStorage.setItem(STORE, JSON.stringify(state)); } catch (e) {}
  }

  const TITLE_FIXUPS = { dm: 'DM', pcs: 'PCs', npcs: 'NPCs', vava: 'VAVA', phb: 'PHB' };
  function titleCase(slug) {
    return slug.replace(/-/g, ' ').replace(/\b\w+\b/g, (w) =>
      TITLE_FIXUPS[w.toLowerCase()] || w[0].toUpperCase() + w.slice(1)
    );
  }

  // Hamburger
  const sidebar = document.getElementById('vos-sidebar');
  const sidebarBackdrop = document.getElementById('vos-sidebar-backdrop');
  const closeSidebar = () => { sidebar.classList.remove('vos-open'); sidebarBackdrop.classList.remove('vos-open'); };
  const openSidebar  = () => { sidebar.classList.add('vos-open');    sidebarBackdrop.classList.add('vos-open'); };
  document.getElementById('vos-hamburger').addEventListener('click', () => {
    sidebar.classList.contains('vos-open') ? closeSidebar() : openSidebar();
  });
  sidebarBackdrop.addEventListener('click', closeSidebar);

  // Highlight Chronicle if we're on the Archive
  if (here.startsWith('/en/Archive')) {
    document.getElementById('vos-chronicle').classList.add('vos-active');
  }

  // Fetch sitemap and build the tree
  fetch('/images/sitemap.json').then(r => r.json()).then(entries => {
    const root = {};
    for (const e of entries) {
      let p = e.url.replace(/^\/+en\/+/, '').replace(/^\/+/, '').replace(/\/$/, '');
      if (!p) continue;
      if (/^Venturia\/DM(\/|$)/i.test(p)) continue;
      if (/^Archive(\/|$)/i.test(p)) continue; // pinned in footer
      const parts = p.split('/');
      let node = root;
      parts.forEach((key, i) => {
        if (!node[key]) node[key] = { _children: {} };
        if (i === parts.length - 1) {
          node[key]._url = e.url;
          node[key]._title = e.title;
          node[key]._isPage = true;
        } else {
          node = node[key]._children;
        }
      });
    }

    function nodeAt(slug) {
      const parts = slug.split('/');
      let node = root;
      for (let i = 0; i < parts.length; i++) {
        const key = parts[i];
        if (!node[key]) return null;
        if (i === parts.length - 1) return node[key];
        node = node[key]._children;
      }
      return null;
    }

    function renderChildren(children, excludeKeys) {
      const keys = Object.keys(children)
        .filter(k => !(excludeKeys || []).includes(k))
        .sort((a, b) => a === 'index' ? -1 : b === 'index' ? 1 : a.localeCompare(b));
      let html = '';
      for (const key of keys) {
        const child = children[key];
        const hasChildren = Object.keys(child._children).length > 0;
        if (key === 'index') {
          const active = child._url && child._url.replace(/\/$/, '') === here ? 'vos-active' : '';
          html += `<a class="vos-page vos-page-overview ${active}" href="${child._url}">index</a>`;
          continue;
        }
        if (hasChildren) {
          const sectionId = 'sec-' + (child._url || key).replace(/[^a-z0-9]/gi, '-');
          html += `<div class="vos-section" data-section-id="${sectionId}">
            <div class="vos-section-title">
              <span class="vos-section-chevron">▸</span>${titleCase(key)}
            </div>
            <div class="vos-pages">${renderChildren(child._children, [])}</div>
          </div>`;
        } else if (child._isPage && child._url) {
          const active = child._url.replace(/\/$/, '') === here ? 'vos-active' : '';
          html += `<a class="vos-page ${active}" href="${child._url}">${child._title || titleCase(key)}</a>`;
        }
      }
      return html;
    }

    function renderTreeChild(child) {
      const node = nodeAt(child.slug);
      if (!node) return '';
      const sectionId = 'sec-' + child.slug.replace(/[^a-z0-9]/gi, '-');
      const overviewUrl = node._isPage ? node._url : null;
      const childHtml = renderChildren(node._children, child.excludeChildren);
      const overviewLink = overviewUrl
        ? `<a class="vos-page vos-page-overview${overviewUrl.replace(/\/$/, '') === here ? ' vos-active' : ''}" href="${overviewUrl}">index</a>`
        : '';
      return `<div class="vos-section" data-section-id="${sectionId}">
        <div class="vos-section-title">
          <span class="vos-section-chevron">▸</span>${child.title}
        </div>
        <div class="vos-pages">${overviewLink}${childHtml}</div>
      </div>`;
    }

    function renderExternalChild(child) {
      return `<a class="vos-page vos-page-external" href="${child.url}" target="_blank" rel="noopener">${child.title}</a>`;
    }

    function renderInternalChild(child) {
      const active = child.url.replace(/\/$/, '') === here ? ' vos-active' : '';
      return `<a class="vos-page${active}" href="${child.url}">${child.title}</a>`;
    }

    function renderGroup(group) {
      const body = group.children.map(c => {
        if (c.kind === 'tree')     return renderTreeChild(c);
        if (c.kind === 'internal') return renderInternalChild(c);
        return renderExternalChild(c);
      }).join('');
      return `<div class="vos-group" data-group-id="${group.id}">
        <button class="vos-group-head" type="button">
          <span class="vos-group-chevron">▸</span>${group.label}
        </button>
        <div class="vos-group-body">${body}</div>
      </div>`;
    }

    const sidebarTree = document.getElementById('vos-sidebar-tree');
    sidebarTree.innerHTML = NAV_GROUPS.map(renderGroup).join('');

    // Apply saved + default open states for groups
    const open = loadOpen();
    sidebarTree.querySelectorAll('.vos-group').forEach(g => {
      const id = g.dataset.groupId;
      const groupDef = NAV_GROUPS.find(x => x.id === id);
      const isOpen = id in open ? !!open[id] : !!(groupDef && groupDef.defaultOpen);
      g.classList.toggle('vos-open', isOpen);
    });

    // Apply saved open states for sections (default closed unless contains active)
    sidebarTree.querySelectorAll('.vos-section').forEach(s => {
      const id = s.dataset.sectionId;
      if (id in open && open[id]) s.classList.add('vos-open');
    });

    // Auto-expand the path containing the active page
    const active = sidebarTree.querySelector('.vos-page.vos-active');
    if (active) {
      let p = active.parentElement;
      while (p && p !== sidebarTree) {
        if (p.classList && (p.classList.contains('vos-section') || p.classList.contains('vos-group'))) {
          p.classList.add('vos-open');
        }
        p = p.parentElement;
      }
      setTimeout(() => active.scrollIntoView({ block: 'center' }), 50);
    }

    // Wire group toggles (save to localStorage)
    sidebarTree.querySelectorAll('.vos-group-head').forEach(head => {
      head.addEventListener('click', () => {
        const group = head.parentElement;
        const id = group.dataset.groupId;
        group.classList.toggle('vos-open');
        const state = loadOpen();
        state[id] = group.classList.contains('vos-open');
        saveOpen(state);
      });
    });
    // Wire section toggles
    sidebarTree.querySelectorAll('.vos-section-title').forEach(title => {
      title.addEventListener('click', () => {
        const section = title.parentElement;
        const id = section.dataset.sectionId;
        section.classList.toggle('vos-open');
        const state = loadOpen();
        state[id] = section.classList.contains('vos-open');
        saveOpen(state);
      });
    });
  }).catch(e => {
    document.getElementById('vos-sidebar-tree').innerHTML =
      '<div class="vos-sidebar-loading">Sidebar unavailable. Run <code>python3 build_sitemap.py</code> and rebuild.</div>';
    console.error(e);
  });
})();
</script>
</body>
</html>
