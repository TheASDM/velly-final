<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title or "Valley of Shadows — Codex" }}{% if title %} · Valley of Shadows{% endif %}</title>
{% if description %}<meta name="description" content="{{ description }}">{% endif %}
{% if tags %}<meta name="keywords" content="{{ tags }}">{% endif %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Crimson+Text:ital,wght@0,400;0,600;1,400&family=IM+Fell+English:ital@0;1&display=swap" rel="stylesheet">

<link href="/pagefind/pagefind-ui.css" rel="stylesheet">

<style>
  :root {
    --vos-gold-bright: #d4a574;
    --vos-gold-dim: #8b7355;
    --vos-cream: #e8dcc8;
    --vos-text: #c9b896;
    --vos-text-body: #d4c7ad;
    --vos-bg: #0d0b11;
    --vos-bg-panel: rgba(13, 11, 17, 0.97);
    --vos-border: rgba(139, 115, 85, 0.3);
    --vos-quest: #a0322a;
    --vos-quest-bright: #d44d3f;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; background: var(--vos-bg); color: var(--vos-text-body); }

  /* Themed scrollbars — gold-on-dark instead of the default OS chrome */
  * { scrollbar-width: thin; scrollbar-color: rgba(139, 115, 85, 0.45) transparent; }
  ::-webkit-scrollbar { width: 8px; height: 8px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: rgba(139, 115, 85, 0.35); border-radius: 4px; border: 1px solid rgba(13, 11, 17, 0.6); }
  ::-webkit-scrollbar-thumb:hover { background: rgba(212, 165, 116, 0.55); }
  ::-webkit-scrollbar-corner { background: transparent; }
  iframe { color-scheme: dark; }
  body {
    font-family: 'Crimson Text', Georgia, serif;
    font-size: 17px;
    line-height: 1.65;
    padding-top: 52px;
  }
  @media (min-width: 1024px) {
    body { padding-left: 280px; }
  }

  /* Headings — Cinzel display caps for h1/h2, lighter for sub */
  h1, h2 { font-family: 'Cinzel', Georgia, serif; color: var(--vos-gold-bright); letter-spacing: 0.06em; line-height: 1.2; }
  h1 { font-size: 2.2rem; margin: 2rem 0 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--vos-border); }
  h2 { font-size: 1.5rem; margin: 2rem 0 0.75rem; }
  h3 { font-family: 'Cinzel', Georgia, serif; color: var(--vos-cream); font-size: 1.15rem; letter-spacing: 0.04em; margin: 1.5rem 0 0.5rem; }
  h4, h5, h6 { color: var(--vos-cream); }
  hr { border: none; border-top: 1px solid var(--vos-border); margin: 2rem 0; }

  a { color: var(--vos-gold-bright); text-decoration: none; border-bottom: 1px solid transparent; transition: border-color 0.15s; }
  a:hover { border-bottom-color: var(--vos-gold-bright); }

  blockquote { border-left: 3px solid var(--vos-gold-dim); margin: 1.5rem 0; padding: 0.5rem 1.25rem; color: var(--vos-text); font-style: italic; }

  code { background: rgba(212, 165, 116, 0.1); color: var(--vos-cream); padding: 0.1rem 0.4rem; border-radius: 3px; font-size: 0.92em; }
  pre { background: rgba(13, 11, 17, 0.6); border: 1px solid var(--vos-border); border-radius: 4px; padding: 1rem; overflow-x: auto; }
  pre code { background: none; padding: 0; }

  table { border-collapse: collapse; margin: 1.5rem 0; width: 100%; }
  th, td { border: 1px solid var(--vos-border); padding: 0.5rem 0.75rem; text-align: left; }
  th { background: rgba(212, 165, 116, 0.08); color: var(--vos-cream); font-family: 'Cinzel', Georgia, serif; font-size: 0.85rem; letter-spacing: 0.04em; text-transform: uppercase; }

  img { max-width: 100%; height: auto; }

  main.vos-content { max-width: 820px; margin: 0 auto; padding: 2rem 1.5rem 6rem; }
  main.vos-content article { font-family: 'Crimson Text', Georgia, serif; }

  /* ── Top bar ───────────────────────────────────────────────────────── */
  .vos-topnav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 1100;
    background: var(--vos-bg-panel); border-bottom: 1px solid var(--vos-border);
    padding: 0.55rem 1.5rem;
    display: flex; align-items: center; gap: 0.25rem;
    font-family: 'Cinzel', Georgia, serif;
  }
  .vos-topnav .vos-logo { font-weight: 600; color: var(--vos-gold-bright); font-size: 0.78rem; letter-spacing: 0.32em; text-transform: uppercase; margin-right: 1.5rem; text-decoration: none; border-bottom: none; }
  .vos-topnav a:not(.vos-logo):not(.vos-quest-btn) { font-size: 0.66rem; letter-spacing: 0.32em; text-transform: uppercase; color: var(--vos-gold-dim); padding: 0.5rem 0.85rem; border-bottom: none; }
  .vos-topnav a:hover { color: var(--vos-gold-bright); }
  .vos-topnav a.vos-active { color: var(--vos-gold-bright); }
  .vos-topnav .vos-spacer { flex: 1; }
  .vos-hamburger { display: none; cursor: pointer; color: var(--vos-gold-bright); font-size: 1.3rem; padding: 0 0.5rem; user-select: none; }

  /* The big red Foundry button */
  .vos-quest-btn {
    background: linear-gradient(180deg, var(--vos-quest-bright), var(--vos-quest));
    color: #fff !important;
    font-family: 'Cinzel', Georgia, serif;
    font-size: 0.72rem; font-weight: 600;
    letter-spacing: 0.22em; text-transform: uppercase;
    padding: 0.55rem 1.1rem !important;
    border-radius: 4px;
    box-shadow: 0 2px 8px rgba(212, 77, 63, 0.35), inset 0 1px 0 rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.12) !important;
    margin-left: 0.75rem;
    white-space: nowrap;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .vos-quest-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(212, 77, 63, 0.55), inset 0 1px 0 rgba(255,255,255,0.2);
    border-bottom: 1px solid rgba(255,255,255,0.12) !important;
    color: #fff !important;
  }
  .vos-quest-btn .vos-quest-spark { color: rgba(255, 220, 180, 0.95); margin-right: 0.4rem; }

  @media (max-width: 1023px) {
    .vos-topnav { padding: 0.55rem 0.75rem; gap: 0.5rem; flex-wrap: wrap; }
    .vos-hamburger { display: inline-block; }
    .vos-topnav a:not(.vos-logo):not(.vos-mobile-show) { display: none; }
    .vos-quest-btn { font-size: 0.62rem; padding: 0.4rem 0.7rem !important; margin-left: 0.25rem; }
  }

  /* ── Search banner ─────────────────────────────────────────────────── */
  .vos-search-banner {
    background: linear-gradient(180deg, rgba(13, 11, 17, 0.95), rgba(13, 11, 17, 0.85));
    border-bottom: 1px solid var(--vos-border);
    padding: 1.5rem 1.5rem 1.25rem;
  }
  .vos-search-banner-inner { max-width: 820px; margin: 0 auto; }
  .vos-search-label {
    display: block;
    font-family: 'Cinzel', Georgia, serif;
    color: var(--vos-gold-bright);
    font-size: 0.72rem; letter-spacing: 0.32em; text-transform: uppercase;
    margin-bottom: 0.5rem; opacity: 0.85;
  }
  /* Pagefind UI override — make it match the gold/dark palette */
  .pagefind-ui {
    --pagefind-ui-primary: var(--vos-gold-bright);
    --pagefind-ui-text: var(--vos-text-body);
    --pagefind-ui-background: rgba(13, 11, 17, 0.85);
    --pagefind-ui-border: var(--vos-border);
    --pagefind-ui-tag: rgba(212, 165, 116, 0.15);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 4px;
    --pagefind-ui-font: 'Crimson Text', Georgia, serif;
  }
  .pagefind-ui__search-input {
    font-family: 'Crimson Text', Georgia, serif !important;
    font-size: 1.05rem !important;
    background: rgba(13, 11, 17, 0.6) !important;
    color: var(--vos-cream) !important;
  }
  .pagefind-ui__search-input::placeholder { color: var(--vos-gold-dim); }
  .pagefind-ui__result-link { color: var(--vos-gold-bright) !important; font-family: 'Cinzel', Georgia, serif; }
  .pagefind-ui__result-excerpt { color: var(--vos-text) !important; }
  .pagefind-ui__result-tags, .pagefind-ui__filter-name, .pagefind-ui__message {
    color: var(--vos-text) !important;
  }
  .vos-search-fallback {
    font-style: italic; color: var(--vos-gold-dim);
    font-size: 0.9rem;
    padding: 0.5rem 0;
  }

  /* ── Auto-index list ───────────────────────────────────────────────── */
  .vos-auto-index { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--vos-border); }
  .vos-auto-index h2.vos-auto-index-title {
    color: var(--vos-gold-bright); font-family: 'Cinzel', Georgia, serif;
    font-size: 1.35rem; letter-spacing: 0.06em; margin-top: 0;
  }
  .vos-auto-index .vos-auto-sub { margin: 1.5rem 0; }
  .vos-auto-index .vos-auto-sub > h3 {
    margin: 1.5rem 0 0.5rem; font-size: 1.1rem;
    color: var(--vos-cream); font-family: 'Cinzel', Georgia, serif;
    letter-spacing: 0.06em;
  }
  .vos-auto-index ul {
    list-style: none; padding: 0; margin: 0.4rem 0 0 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.35rem 1.25rem;
  }
  .vos-auto-index li { padding: 0.15rem 0; }
  .vos-auto-index li a { font-size: 1rem; }

  /* ── Sidebar ────────────────────────────────────────────────────────── */
  .vos-sidebar {
    position: fixed; top: 52px; left: 0; bottom: 0; width: 280px; z-index: 1000;
    background: var(--vos-bg-panel); border-right: 1px solid var(--vos-border);
    overflow-y: auto; padding: 1.5rem 1rem 3rem;
    font-family: 'Crimson Text', Georgia, serif;
    transition: transform 0.3s ease;
  }
  .vos-section { margin-bottom: 0.4rem; }
  .vos-section-title { display: flex; align-items: center; cursor: pointer; user-select: none; color: var(--vos-gold-bright); font-family: 'Cinzel', Georgia, serif; letter-spacing: 0.18em; text-transform: uppercase; font-size: 0.72rem; padding: 0.55rem 0.25rem; border-bottom: 1px solid rgba(139, 115, 85, 0.15); }
  .vos-section-title::before { content: '▸'; margin-right: 0.5rem; opacity: 0.7; transition: transform 0.2s; font-size: 0.7rem; }
  .vos-section.vos-open > .vos-section-title::before { transform: rotate(90deg); }
  .vos-pages { display: none; padding: 0.4rem 0 0.5rem 0.7rem; border-left: 1px solid rgba(139, 115, 85, 0.12); margin-left: 0.6rem; }
  .vos-section.vos-open > .vos-pages { display: block; }
  .vos-page { display: block; color: var(--vos-text); padding: 0.32rem 0.25rem; font-size: 0.85rem; line-height: 1.35; border-radius: 3px; border-bottom: none; }
  .vos-page:hover { color: var(--vos-gold-bright); background: rgba(212, 165, 116, 0.05); }
  .vos-page.vos-active { color: var(--vos-gold-bright); background: rgba(212, 165, 116, 0.1); border-left: 2px solid var(--vos-gold-bright); padding-left: 0.5rem; margin-left: -0.5rem; }
  @media (max-width: 1023px) {
    .vos-sidebar { transform: translateX(-100%); }
    .vos-sidebar.vos-open { transform: translateX(0); box-shadow: 4px 0 20px rgba(0,0,0,0.6); }
  }

  /* ── Enzo footer embed ──────────────────────────────────────────────── */
  .vos-enzo-footer {
    margin-top: 4rem; padding-top: 2rem;
    border-top: 1px solid var(--vos-border);
  }
  .vos-enzo-footer h2 {
    color: var(--vos-gold-bright); font-family: 'Cinzel', Georgia, serif;
    font-size: 1.25rem; letter-spacing: 0.08em; margin-bottom: 0.25rem;
  }
  .vos-enzo-footer p {
    color: var(--vos-text); font-style: italic; margin: 0 0 1rem;
  }
  #chatbot-container { min-height: 480px; }
</style>
</head>
<body>

<nav class="vos-topnav">
  <span class="vos-hamburger vos-mobile-show" id="vos-hamburger">☰</span>
  <a href="/" class="vos-logo vos-mobile-show">Valley of Shadows</a>
  <a href="/en/Venturia/">Venturia</a>
  <a href="/en/Venturia/Characters/">Characters</a>
  <a href="/en/Venturia/Locations/">Locations</a>
  <a href="/en/Articles/">Articles</a>
  <a href="/en/Updates/">Updates</a>
  <a href="/en/Class-Changes/">Class Changes</a>
  <a href="/en/House-Rules/">House Rules</a>
  <span class="vos-spacer"></span>
  <a href="https://loremaster.valleyofshadows.wiki/" target="_blank" rel="noopener">Loremaster</a>
  <a href="https://reference.valleyofshadows.wiki/enzo/" target="_blank" rel="noopener">Using Enzo</a>
  <a class="vos-quest-btn vos-mobile-show" href="https://valleyofshadows.quest/" target="_blank" rel="noopener" title="Open the private Foundry server">
    <span class="vos-quest-spark">✦</span>Play on Foundry
  </a>
</nav>

<aside class="vos-sidebar" id="vos-sidebar">
  <div style="color:var(--vos-gold-dim);font-size:0.75rem;letter-spacing:0.1em;">Loading…</div>
</aside>

<section class="vos-search-banner">
  <div class="vos-search-banner-inner">
    <span class="vos-search-label">Search the Codex</span>
    <div id="vos-search"></div>
    <div class="vos-search-fallback" id="vos-search-fallback" hidden>
      Search index isn't built yet — run <code>npm run build</code> to generate it.
    </div>
  </div>
</section>

<main class="vos-content">
  <article>
    {{ content | safe }}
  </article>

  {%- if page.filePathStem and page.filePathStem.endsWith('/index') -%}
    {%- set tree = collections.all | descendantTree(page.url) -%}
    {%- if tree.subcategories.length > 0 or tree.direct.length > 0 -%}
      <section class="vos-auto-index" aria-label="All pages in this section">
        <h2 class="vos-auto-index-title">All Pages in This Section</h2>

        {%- for sub in tree.subcategories -%}
        <div class="vos-auto-sub">
          <h3>{% if sub.url %}<a href="{{ sub.url }}">{{ sub.title }}</a>{% else %}{{ sub.title }}{% endif %}</h3>
          {%- if sub.pages.length > 0 -%}
          <ul>
            {%- for p in sub.pages -%}
            <li><a href="{{ p.url }}">{{ p.title }}</a></li>
            {%- endfor -%}
          </ul>
          {%- endif -%}
        </div>
        {%- endfor -%}

        {%- if tree.direct.length > 0 -%}
        <div class="vos-auto-sub">
          {%- if tree.subcategories.length > 0 -%}<h3>Pages</h3>{%- endif -%}
          <ul>
            {%- for p in tree.direct -%}
            <li><a href="{{ p.url }}">{{ p.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
        {%- endif -%}
      </section>
    {%- endif -%}
  {%- endif -%}

  <section class="vos-enzo-footer">
    <h2>Ask Enzo</h2>
    <p>Enzo is the campaign's loremaster — ask anything about Venturia, the rules, or the characters.</p>
    <div id="chatbot-container"></div>
  </section>
</main>

<link rel="stylesheet" href="https://loremaster.valleyofshadows.wiki/css/chatbot.css">
<script>window.LOREMASTER_API_URL = 'https://loremaster.valleyofshadows.wiki/api/chat';</script>
<script src="https://loremaster.valleyofshadows.wiki/js/chatbot.js" defer></script>

<script src="/pagefind/pagefind-ui.js" onerror="document.getElementById('vos-search-fallback').hidden=false;"></script>
<script>
window.addEventListener('DOMContentLoaded', () => {
  if (typeof PagefindUI !== 'undefined') {
    new PagefindUI({
      element: '#vos-search',
      showImages: false,
      showSubResults: true,
      resetStyles: false,
      placeholder: 'Search for a character, location, faction, rule…',
    });
  } else {
    document.getElementById('vos-search-fallback').hidden = false;
  }
});
</script>

<script>
(function () {
  const here = location.pathname.replace(/\/$/, '');
  document.querySelectorAll('.vos-topnav a').forEach(a => {
    const href = a.getAttribute('href');
    if (!href || href.startsWith('http')) return;
    const base = href.replace(/\/$/, '');
    if (base && here.startsWith(base)) a.classList.add('vos-active');
  });
  const sidebar = document.getElementById('vos-sidebar');
  document.getElementById('vos-hamburger').addEventListener('click', () => sidebar.classList.toggle('vos-open'));

  function titleCase(slug) {
    return slug.replace(/-/g, ' ').replace(/\bdm\b/i, 'DM').replace(/\bpcs\b/i, 'PCs').replace(/\bnpcs\b/i, 'NPCs').replace(/\bvava\b/i, 'VAVA').replace(/\bphb\b/i, 'PHB').replace(/\b\w/g, c => c.toUpperCase());
  }

  fetch('/images/sitemap.json').then(r => r.json()).then(entries => {
    const tree = {};
    for (const e of entries) {
      let p = e.url.replace(/^\/+en\/+/, '').replace(/^\/+/, '').replace(/\/$/, '');
      if (!p) continue;
      if (/^Venturia\/DM(\/|$)/i.test(p)) continue;
      const parts = p.split('/');
      let node = tree;
      parts.forEach((key, i) => {
        if (i === parts.length - 1) { node[key] = node[key] || { _children: {} }; node[key]._url = e.url; node[key]._title = e.title; node[key]._isPage = true; }
        else { node[key] = node[key] || { _children: {} }; node = node[key]._children; }
      });
    }
    function render(children) {
      const keys = Object.keys(children).sort((a, b) => a === 'index' ? -1 : b === 'index' ? 1 : a.localeCompare(b));
      let html = '';
      for (const key of keys) {
        const child = children[key];
        const hasChildren = Object.keys(child._children).length > 0;
        if (key === 'index') {
          const active = child._url && child._url.replace(/\/$/, '') === here ? 'vos-active' : '';
          html += `<a class="vos-page ${active}" href="${child._url}" style="font-style:italic;opacity:0.85;">overview →</a>`;
          continue;
        }
        if (hasChildren) {
          html += `<div class="vos-section"><div class="vos-section-title">${titleCase(key)}</div><div class="vos-pages">${render(child._children)}</div></div>`;
        } else if (child._isPage && child._url) {
          const active = child._url.replace(/\/$/, '') === here ? 'vos-active' : '';
          html += `<a class="vos-page ${active}" href="${child._url}">${child._title || titleCase(key)}</a>`;
        }
      }
      return html;
    }
    sidebar.innerHTML = render(tree);
    sidebar.querySelectorAll('.vos-section-title').forEach(el => el.addEventListener('click', () => el.parentElement.classList.toggle('vos-open')));
    const active = sidebar.querySelector('.vos-page.vos-active');
    if (active) {
      let p = active.parentElement;
      while (p && p !== sidebar) { if (p.classList && p.classList.contains('vos-section')) p.classList.add('vos-open'); p = p.parentElement; }
      setTimeout(() => active.scrollIntoView({ block: 'center' }), 50);
    } else {
      const first = sidebar.querySelector('.vos-section');
      if (first) first.classList.add('vos-open');
    }
  }).catch(e => {
    sidebar.innerHTML = '<div style="color:var(--vos-gold-dim);font-size:0.78rem;">Sidebar unavailable. Run <code>python3 build_sitemap.py</code> then rebuild.</div>';
    console.error(e);
  });
})();
</script>
</body>
</html>
