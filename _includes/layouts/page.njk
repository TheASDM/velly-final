<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ title or "Valley of Shadows — Codex" }}{% if title %} · Valley of Shadows{% endif %}</title>
{% if description %}<meta name="description" content="{{ description }}">{% endif %}
{% if tags %}<meta name="keywords" content="{{ tags }}">{% endif %}

<link rel="icon" type="image/png" href="/images/app-icon/favicon.png">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="apple-touch-icon" href="/images/app-icon/apple-touch-icon.png">
<meta name="theme-color" content="#07060a">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Foglight">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Crimson+Text:ital,wght@0,400;0,600;1,400&family=IM+Fell+English:ital@0;1&display=swap" rel="stylesheet">

<link href="/pagefind/pagefind-ui.css" rel="stylesheet">
<link href="/css/app-shell.css" rel="stylesheet">
{% for stylesheet in pageStyles %}<link href="{{ stylesheet }}" rel="stylesheet">
{% endfor %}

</head>
<body class="{% if page.url == '/enzo/' %}vos-is-enzo-page{% endif %}{% if page.url == '/messages/' %}vos-is-messages-page{% endif %}{% if page.url and page.url.startsWith('/en/') and page.url != '/en/Tools/art/' %} vos-is-wiki-page{% endif %}{% if page.filePathStem and page.filePathStem.endsWith('/index') %} vos-is-index-page{% endif %}">

<div class="vos-backdrop" aria-hidden="true"></div>

{%- set isWikiPage = page.url and page.url.startsWith('/en/') and page.url != '/en/Tools/art/' -%}
{%- set crumbs = [] -%}
{%- set parentCrumb = null -%}
{%- if isWikiPage -%}
  {%- set crumbs = page.url | wikiBreadcrumbs(title) -%}
  {%- set parentCrumb = crumbs | wikiParentCrumb -%}
{%- endif -%}
{%- set appBar = page.url | appBarMeta(title) -%}
{%- set appTitle = appBar.title -%}
{%- set appEyebrow = appBar.eyebrow -%}

<header class="vos-app-bar{% if crumbs.length > 1 %} has-crumbs{% endif %}" role="banner">
  <div class="vos-app-bar-inner">
    <div class="vos-app-bar-row">
      {%- if page.url == "/settings/" -%}
      <button class="vos-app-icon-button vos-app-back" id="vos-settings-back" type="button" aria-label="Back">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      {%- elif parentCrumb and parentCrumb.url -%}
      <a class="vos-app-icon-button vos-app-back" href="{{ parentCrumb.url }}" aria-label="Back to {{ parentCrumb.title }}">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg>
      </a>
      {%- else -%}
      {#- No back target: the crest, which is also the way home. -#}
      <a class="vos-app-icon-button vos-app-crest" href="/" aria-label="Home">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3.2 19 6v6.1c0 4-2.8 7.2-7 8.7-4.2-1.5-7-4.7-7-8.7V6z"/><path d="M12 8.4v6.4"/><path d="M9.2 11.2h5.6"/></svg>
      </a>
      {%- endif -%}
      <div class="vos-app-title-block">
        <div class="vos-app-eyebrow">{{ appEyebrow }}</div>
        <div class="vos-app-title">{{ appTitle }}</div>
      </div>
      <div class="vos-app-actions">
        {#- Four icon-only controls beside a truncating title: chat, settings,
            menu, you. Below 360px the gear folds back into the menu (CSS). -#}
        <button class="vos-app-icon-button vos-app-chat" id="vos-chat-button" type="button" aria-label="Chat" title="Chat" aria-expanded="false">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20 12a8 8 0 0 1-8 8H7.6L4 22.4V12a8 8 0 0 1 16 0z"/><path d="M8.5 11h7"/><path d="M8.5 14.5h4.5"/></svg>
          <span class="vos-app-chat-count" id="vos-chat-count" hidden></span>
        </button>
        <a class="vos-app-icon-button vos-app-gear" id="vos-app-gear" href="/settings/" aria-label="Settings" title="Settings">
          <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.1"/><path d="M19.4 14.6a1.6 1.6 0 0 0 .32 1.77l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.6 1.6 0 0 0-1.77-.32 1.6 1.6 0 0 0-.97 1.47V21a2 2 0 1 1-4 0v-.11a1.6 1.6 0 0 0-1.05-1.47 1.6 1.6 0 0 0-1.77.32l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.6 1.6 0 0 0 .32-1.77 1.6 1.6 0 0 0-1.47-.97H3a2 2 0 1 1 0-4h.11a1.6 1.6 0 0 0 1.47-1.05 1.6 1.6 0 0 0-.32-1.77l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.6 1.6 0 0 0 1.77.32H9a1.6 1.6 0 0 0 .97-1.47V3a2 2 0 1 1 4 0v.11a1.6 1.6 0 0 0 .97 1.47 1.6 1.6 0 0 0 1.77-.32l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.6 1.6 0 0 0-.32 1.77V9a1.6 1.6 0 0 0 1.47.97H21a2 2 0 1 1 0 4h-.11a1.6 1.6 0 0 0-1.47.97z"/></svg>
        </a>
        <div class="vos-app-user-menu-wrap">
          <button class="vos-app-identity" id="vos-app-identity-button" type="button" aria-label="Menu" title="Menu" aria-haspopup="menu" aria-expanded="false">
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></svg>
            <span class="vos-app-identity-label" id="vos-app-identity-label">Log in</span>
          </button>
          <div class="vos-user-menu" id="vos-user-menu" role="menu" hidden>
            <div class="vos-user-menu-head" id="vos-user-menu-name">Not signed in</div>
            <a role="menuitem" href="/notes/">Notes</a>
            <a role="menuitem" href="/questionnaire/">Character Record</a>
            <a role="menuitem" href="/sheet/">Character Sheet</a>
            <a role="menuitem" href="/calendar/#next">RSVPs</a>
            <a role="menuitem" href="/calendar/#availability">Availability</a>
            <a role="menuitem" href="/submit-lore/#vos-submit-mine-title">Lore Submissions</a>
            <a role="menuitem" href="/art-submissions/">Art Submissions</a>
            <a role="menuitem" href="/en/Tools/art/?favorites=1#vos-art-gallery-section">Favorites</a>
            {#- Only rendered as a row on the narrowest phones, where the
                gear leaves the bar. See .vos-user-menu-narrow-only. -#}
            <a role="menuitem" class="vos-user-menu-narrow-only" href="/settings/">Settings</a>
            <button role="menuitem" id="vos-user-menu-sign-in" type="button">Sign in</button>
            {#- The console's grouped index carries the per-tool detail now;
                the menu only needs the doors. -#}
            <div class="vos-user-menu-group" id="vos-user-menu-dm" hidden>
              <div class="vos-user-menu-label">DM</div>
              <a role="menuitem" href="/dm/">Console</a>
              <a role="menuitem" href="/party/">The Table</a>
              <a role="menuitem" href="/monsters/">Bench</a>
              <a role="menuitem" href="/sheets/">Character Sheets</a>
              <a role="menuitem" href="/dossiers/">Dossiers</a>
            </div>
            <button role="menuitem" id="vos-user-menu-sign-out" type="button" hidden>Sign out</button>
          </div>
        </div>
        {#- The avatar opens your own profile; the gear beside it is the
            door to settings. -#}
        <a class="vos-app-icon-button vos-app-profile" id="vos-profile-button" href="/profile/" aria-label="Your profile" title="Your profile">
          <span class="vos-app-avatar-wrap">
            <img class="vos-app-avatar-img" id="vos-app-avatar-img" alt="">
            <svg class="vos-app-avatar-fallback" id="vos-app-avatar-fallback" aria-hidden="true" viewBox="0 0 24 24"><path d="M20 21a8 8 0 0 0-16 0"/><circle cx="12" cy="8" r="4"/></svg>
            <span class="vos-app-avatar-badge" id="vos-app-avatar-badge" hidden></span>
          </span>
        </a>
      </div>
    </div>
    {%- if crumbs.length > 1 -%}
    <nav aria-label="Breadcrumb">
      <ol class="vos-app-crumbs">
        {%- for crumb in crumbs -%}
        <li>
          {%- if crumb.url and not loop.last -%}
          <a href="{{ crumb.url }}">{{ crumb.title }}</a>
          {%- else -%}
          <span aria-current="page">{{ crumb.title }}</span>
          {%- endif -%}
        </li>
        {%- endfor -%}
      </ol>
    </nav>
    {%- endif -%}
  </div>
</header>
<div class="vos-app-bar-spacer{% if crumbs.length > 1 %} has-crumbs{% endif %}" aria-hidden="true"></div>

<main class="vos-content">
  <article class="vos-page-shell{% if page.filePathStem == '/home' %} vos-home-shell{% endif %}{% if page.url == '/en/Venturia/' %} vos-wiki-home-shell{% endif %}">
    {{ content | safe }}
  </article>

  {%- if isWikiPage -%}
  <a class="vos-wiki-edit-link" id="vos-wiki-edit-link" href="/dm/?wiki={{ page.url }}#vos-dm-wiki-title" data-wiki-url="{{ page.url }}" hidden>Edit Wiki</a>
  {%- endif -%}

  {#- Related pages, from tags the page already carried. A wiki this size is
      easier to wander than to search, and the tree only goes one direction. -#}
  {%- if page.url and page.url.startsWith('/en/') and not page.filePathStem.endsWith('/index') -%}
    {%- set related = collections.all | relatedPages(page.url, 6) -%}
    {%- if related.length > 0 -%}
    <section class="vos-related" aria-label="Related pages">
      <h2 class="vos-related-title">Related</h2>
      <div class="vos-row-chip-list">
        {%- for r in related -%}
        <a class="vos-row-chip" href="{{ r.url }}">
          <span>
            <span class="vos-row-chip-title">{{ r.title }}</span>
            {%- if r.description %}<span class="vos-row-chip-meta">{{ r.description }}</span>{% endif -%}
          </span>
        </a>
        {%- endfor -%}
      </div>
    </section>
    {%- endif -%}
  {%- endif -%}

  {%- if page.filePathStem and page.filePathStem.endsWith('/index') and autoIndex != false -%}
    {%- set tree = collections.all | descendantTree(page.url) -%}
    {%- if tree.subcategories.length > 0 or tree.direct.length > 0 -%}
      <section class="vos-auto-index" aria-label="All pages in this section">
        <h2 class="vos-auto-index-title">{% if page.url == '/en/Venturia/' %}Deep Index{% else %}All Pages in This Section{% endif %}</h2>

        {%- for sub in tree.subcategories -%}
        <div class="vos-auto-sub">
          <h3>{% if sub.url %}<a href="{{ sub.url }}">{{ sub.title }}</a>{% else %}{{ sub.title }}{% endif %}</h3>
          {%- if sub.pages.length > 0 -%}
          <ul>
            {%- for p in sub.pages -%}
            <li>
              <a class="vos-row-chip" href="{{ p.url }}">
                <span>
                  <span class="vos-row-chip-title">{{ p.title }}</span>
                  {%- if p.description -%}<span class="vos-row-chip-meta">{{ p.description }}</span>{%- endif -%}
                </span>
                <span class="vos-row-chip-arrow" aria-hidden="true">›</span>
              </a>
            </li>
            {%- endfor -%}
          </ul>
          {%- endif -%}
        </div>
        {%- endfor -%}

        {%- if tree.direct.length > 0 -%}
        <div class="vos-auto-sub">
          {%- if tree.subcategories.length > 0 -%}<h3>Pages</h3>{%- endif -%}
          <ul>
            {%- for p in tree.direct -%}
            <li>
              <a class="vos-row-chip" href="{{ p.url }}">
                <span>
                  <span class="vos-row-chip-title">{{ p.title }}</span>
                  {%- if p.description -%}<span class="vos-row-chip-meta">{{ p.description }}</span>{%- endif -%}
                </span>
                <span class="vos-row-chip-arrow" aria-hidden="true">›</span>
              </a>
            </li>
            {%- endfor -%}
          </ul>
        </div>
        {%- endif -%}
      </section>
    {%- endif -%}
  {%- endif -%}
</main>

<div class="vos-pwa-card" id="vos-pwa-install" hidden role="region" aria-label="Install Foglight">
  <div class="vos-pwa-card-title" id="vos-pwa-install-title">Install Foglight</div>
  <p class="vos-pwa-card-text" id="vos-pwa-install-text">Add this app to your home screen.</p>
  <div class="vos-pwa-actions">
    <button class="vos-pwa-primary" id="vos-pwa-install-action" type="button">Install</button>
    <button class="vos-pwa-dismiss" id="vos-pwa-install-dismiss" type="button" aria-label="Dismiss install prompt">×</button>
  </div>
</div>

<div class="vos-pwa-update" id="vos-pwa-update" hidden role="status" aria-live="polite">
  <div class="vos-pwa-update-title">New version</div>
  <p class="vos-pwa-update-text">New version — tap to refresh.</p>
  <div class="vos-pwa-actions">
    <button class="vos-pwa-primary" id="vos-pwa-refresh" type="button">Refresh</button>
  </div>
</div>

{% include "partials/app-bottom-nav.njk" %}

<!-- Enzo floating chat widget. The widget loader handles both production
     (loads /js/chatbot.js + /css/chatbot.css) and local preview (renders
     a visual-only stub). See public/js/enzo-widget.js. -->
<div id="chatbot-container"></div>

{% for script in pageScripts %}<script src="{{ script }}" defer></script>
{% endfor %}
<script src="/js/in-play-live.js" defer></script>
<script src="/js/enzo-widget.js" defer></script>
<script src="/js/viewport-handler.js" defer></script>
<script src="/js/pwa-manager.js" defer></script>
<script src="/js/pwa-client.js" defer></script>
<script src="/js/vos-chat.js" defer></script>

<!-- ── Pagefind site search ─────────────────────────────────────────── -->
<script src="/pagefind/pagefind-ui.js" defer></script>
<script src="/js/search-init.js" defer></script>
</body>
</html>
