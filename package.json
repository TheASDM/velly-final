{
  "name": "valley-of-shadows-codex",
  "version": "1.0.0",
  "private": true,
  "description": "Static PWA build for the Valley of Shadows campaign wiki, app shell, Enzo chatbot, calendar, and art studio.",
  "scripts": {
    "dev": "eleventy && npm run search && eleventy --serve --port=8080",
    "build": "eleventy && npm run search",
    "search": "pagefind --site _site --output-subdir pagefind",
    "clean": "rm -rf _site",
    "sitemap": "python3 build_sitemap.py"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "pagefind": "^1.1.0"
  }
}
