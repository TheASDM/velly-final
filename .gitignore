# Environment variables - NEVER commit real keys
.env
.env.local
.githubkey

# SSL certificates
ssl/

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Chat logs (written by chatbot container at runtime)
logs/*.log

# Art Studio gallery — runtime user-generated content, lives on the chatbot
# volume mount. Keep the directory shape so the volume mount succeeds on
# fresh checkouts, but ignore everything inside it.
generated-art/**
!generated-art/
!generated-art/.gitkeep

# PWA runtime data — SQLite database for push/messages/RSVPs.
app-data/**
!app-data/
!app-data/.gitkeep

# Generated Enzo knowledge artifacts (rebuilt on the deployment host)
campaign-data/tier1.md
campaign-data/vector_store.json
# Legacy split-mode store from before the player-only refactor
campaign-data/vector_store_player.json

# Node modules
node_modules/

# Local archives (never intended for the repo)
*.zip

# Eleventy / Node
node_modules/
_site/
.eleventy.cache/

# Editor backup files
*.bak

# Local-only loose scratch files in repo root
cloudpw.txt
/.txt

# Unused image scratch dir
Tools/image/

# macOS Finder duplicates ("file 2.json" style — note: no quotes; literal
# quotes in gitignore are matched as characters, not metacharacters)
* 2.*
