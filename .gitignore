# Environment variables - NEVER commit real keys
.env
.env.local
.githubkey

# SSL certificates
ssl/

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Chat logs (written by chatbot container at runtime)
logs/*.log

# Art Studio gallery — runtime user-generated content, lives on the chatbot
# volume mount. Keep the directory shape so the volume mount succeeds on
# fresh checkouts, but ignore everything inside it.
generated-art/**
!generated-art/
!generated-art/.gitkeep

# PWA runtime data — SQLite database for push/messages/RSVPs.
app-data/**
!app-data/
!app-data/.gitkeep

# Questionnaire exports written by export_questionnaires.py. These are the
# players' own writing and this repo is public — never commit them.
backups/

# Generated Enzo knowledge artifacts (rebuilt on the deployment host)
campaign-data/tier1.md
campaign-data/.tier1.manifest.json
campaign-data/vector_store.json
# Raw verbatim sourcebook text staged for curation — copyrighted, repo is public
campaign-data/curated/book-vgm.json
# Legacy split-mode store from before the player-only refactor
campaign-data/vector_store_player.json

# Node modules
node_modules/

# Local Python tooling and bytecode
.venv/
__pycache__/
*.py[cod]

# Local archives (never intended for the repo)
*.zip

# Eleventy / Node
node_modules/
_site/
.eleventy.cache/

# Editor backup files
*.bak

# Local-only loose scratch files in repo root
cloudpw.txt
/.txt

# Unused image scratch dir
Tools/image/

# macOS Finder duplicates — both "file 2.json" and duplicate DIRECTORIES
# ("_site/en 2" style). Note: no quotes; literal quotes in gitignore are
# matched as characters, not metacharacters.
* 2.*
* 2
* 2/
claude-project-export/

# Env/config backups — these are verbatim copies of .env and hold live secrets.
# *.bak above does not catch the dated/suffixed forms.
.env.*
!.env.example
*.bak-*
*.before-pull

# files/ is a raw drop zone for standalone documents served at /files/. It
# routinely holds DM-only spoiler material, player-written content, and
# session prep — and this repo is public. Earlier rules here matched by
# naming convention, which silently let anything with an unanticipated name
# through. Deny everything; allow-list only documents that are intentionally
# public. New public documents must be added to the allow-list explicitly.
files/**
!files/ValleyofShadowsFramework.pdf
!files/update5-24-2026.html

# Raw and cleaned Foundry character exports. Player character data — same
# reason: this repo is public.
foundry/
public-files/
