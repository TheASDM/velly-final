# ── Anthropic (Claude) ────────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Which Claude model to use.
# Default: claude-haiku-4-5-20251001
# Other options: claude-sonnet-4-6, claude-opus-4-6
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Max tokens returned by the chat model.
MAX_TOKENS=2048

# ── Ollama / Embeddings ──────────────────────────────────────────────────────
# URL for Ollama embeddings (include /ollama if behind OpenWebUI proxy)
OLLAMA_URL=https://ai.raptornet.dev/ollama

# Bearer token for Ollama/OpenWebUI authentication
OLLAMA_API_KEY=your_ollama_api_key_here

# Must match the model used by build_vectors.py
EMBEDDING_MODEL=nomic-embed-text:latest

# Retrieval tuning. Defaults are fine unless you are actively tuning Enzo.
RAG_TOP_K=3
RAG_AUTO_THRESHOLD=0.3
RAG_LIST_THRESHOLD=0.4

# Claude sampling temperature for chat answers.
TEMPERATURE=0.2

# ── DM Mode ──────────────────────────────────────────────────────────────────
# Passphrase typed into the chat to unlock DM mode (case-insensitive)
DM_PASSPHRASE=Prima Volta

# ── Site display ──────────────────────────────────────────────────────────────
# When the next D&D session is scheduled. Surfaced as a chip in the top bar.
# Auto-hides the chip when the date has passed (end of local day).
# Date only:      NEXT_SESSION_DATE=2026-06-07     → "FRI JUN 7"
# Date + time:    NEXT_SESSION_DATE=2026-06-07T19:00 → "FRI JUN 7 · 7PM"
# Leave unset to hide the chip entirely.
# Rebuild the Eleventy site (`npm run build`) after changing this.
NEXT_SESSION_DATE=

# ── PWA runtime / push notifications ─────────────────────────────────────────
# One-file SQLite runtime state for subscriptions/messages/RSVPs.
APP_DB_PATH=/app/app-data/vallombrosa.sqlite3

# Legacy admin token. OAuth is the real auth path now; keep this blank if
# AUTH_TOKEN_SECRET is set.
ADMIN_TOKEN=

# ── Real player auth (OAuth) ────────────────────────────────────────────────
# Discord is the preferred sign-in provider when configured. Use exact
# redirect URI:
#   https://YOUR_DOMAIN/api/auth/oauth/discord/callback
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=

# Google is kept as a fallback provider. Use exact redirect URI:
#   https://YOUR_DOMAIN/api/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Used to build callback URLs when provider-specific redirect URIs are empty.
PUBLIC_BASE_URL=
# Set to 0 for local HTTP OAuth testing; keep 1 behind HTTPS.
AUTH_COOKIE_SECURE=1

# Map OAuth principals to roster names. Values must be canonical player names
# from _data/players.json, e.g.
# GOOGLE_PLAYER_MAP=car@example.com=Caravel "Car" Asteri,lotan@example.com=Lotan
# DISCORD_PLAYER_MAP=123456789012345678=Lotan,234567890123456789=Noname
GOOGLE_PLAYER_MAP=
DISCORD_PLAYER_MAP=

# DM access from app auth. Google DM accounts can reuse ALLOWED_DM_EMAILS below;
# Discord DM accounts go here as comma-separated Discord user IDs.
ALLOWED_DM_DISCORD_IDS=

# OAuth session token signing. Use a long random value in production.
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_SECONDS=15552000

# Cut off players who already have a token. Tokens are stateless and last
# AUTH_TOKEN_TTL_SECONDS (180 days by default), so dropping someone from
# GOOGLE_PLAYER_MAP / DISCORD_PLAYER_MAP only stops new logins — their
# installed app keeps working until the token expires. Listing them here is
# re-checked on every request, so access ends immediately.
# REVOKED_PLAYERS=Roxanya "Roxy",Valentro
REVOKED_PLAYERS=

# Foundry bridge. The vos-bridge module presents this as a bearer token when it
# pushes a character statblock. Leave blank to keep /api/statblocks/ingest shut.
# Generate with: openssl rand -hex 32
# Syrinscape remote control. Generate at syrinscape.com/account/auth-token/.
# Lets the DM console browse and trigger the Syrinscape library; audio plays
# wherever the Syrinscape player is running, not in the app.
SYRINSCAPE_AUTH_TOKEN=

STATBLOCK_INGEST_TOKEN=
STATBLOCK_MAX_BYTES=2000000

# DM Google fallback for the standalone /dm page. With Discord DM OAuth
# configured, you can still reach /dm after signing in through the site user
# menu. These values keep the direct Google button on /dm working too.
ALLOWED_DM_EMAILS=
SESSION_JWT_SECRET=
SESSION_JWT_TTL_SECONDS=604800

# Legacy invite-code login. Leave blank for OAuth-only auth.
PLAYER_LOGIN_CODES=
PLAYER_CODE_CAR=
PLAYER_CODE_LOTAN=
PLAYER_CODE_NONAME=
PLAYER_CODE_ROXY=
PLAYER_CODE_VALEN=
PLAYER_CODE_DUSTIN=

# VAPID key pair for Web Push. Public key is safe to ship to clients; private
# key must stay in server env. Generate a replacement with:
#   npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=BB824fQSj6QR9ajuVNf6SgPBCQ_l-zRmkTVphiXZUCo6iWvkxa7XtAsuMDdtWbzXsuqMTljCa1prcZtCMU0FCZA
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dm@valleyofshadows.wiki

# ── Art Studio (Tools → Art) ──────────────────────────────────────────────────
# Image generation is wired to OpenAI's images API. Required for the /art
# slash command in the chatbot AND for the standalone Tools/Art Studio page.
OPENAI_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=high
IMAGE_SIZE=1024x1024
STUDIO_MONTHLY_QUOTA=30
IMAGE_TITLE_MODEL=claude-haiku-4-5-20251001
IMAGE_TITLE_TIMEOUT_S=12

# ── The image-prompt compiler ─────────────────────────────────────────────────
# A player's description is compiled into concrete visual direction before it
# reaches the image model. The behavior, the output contract, and the house
# style all live in chatbot/vos/image_prompt_compiler.json — these are only the
# knobs.
#
# Two providers exist so the same request can be compiled both ways and
# compared. The live one is a DM setting (Campaign Settings → Art), stored in
# the database; this env var is only the default before the DM has ever set it.
# Players are never shown that there is a choice.
IMAGE_COMPILER_PROVIDER=claude
IMAGE_COMPILER_CLAUDE_MODEL=claude-opus-5
IMAGE_COMPILER_OPENAI_MODEL=gpt-5
IMAGE_COMPILER_MAX_TOKENS=12000
IMAGE_COMPILER_TIMEOUT_S=120
IMAGE_COMPILER_EFFORT=medium
# 1 logs the whole compiler exchange — request, structured answer, scene
# prompt, final prompt. This is how you tell "the compiler misread the
# request" apart from "the image model rendered a good prompt badly", which
# the finished picture alone cannot tell you. Off in production.
IMAGE_COMPILER_DEBUG=0
# Overrides where the configuration is read from. Normally unset.
# IMAGE_COMPILER_CONFIG=/app/vos/image_prompt_compiler.json

# ── Entity resolution ────────────────────────────────────────────────────────
# Before a prompt is compiled, a cheap model reads it against the catalog of
# canonical names in chatbot/descriptions.json and says which entities the
# image has to show. This is what makes "each party member" or "her fiance"
# ground in the real characters instead of five invented strangers — the
# literal matcher only ever fired on phrases someone typed verbatim.
#
# The model sees names and aliases only. It never sees a description and is
# never asked to write one: the app does the lookup, so a name it invents
# finds nothing. Set to 0 to fall back to literal matching only.
IMAGE_ENTITY_RESOLVER=1
IMAGE_ENTITY_RESOLVER_CLAUDE_MODEL=claude-haiku-4-5-20251001
IMAGE_ENTITY_RESOLVER_OPENAI_MODEL=gpt-5-mini
IMAGE_ENTITY_RESOLVER_TIMEOUT_S=30
IMAGE_ENTITY_RESOLVER_MAX_TOKENS=1000
IMAGE_ENTITY_RESOLVER_MAX_NAMES=8
# ── Session chronicler ────────────────────────────────────────────────────────
# The DM pastes a session's notes and the chronicler researches them against
# the wiki, drafts the chronicle, illustrates it, and proposes the wiki edits
# it implies. Nothing is published without a DM's explicit publish.
#
# The drafting model writes several thousand words that have to stay pinned to
# someone else's notes, which is the one job here worth an Opus. The research
# pass in front of it only resolves names against the catalog, so it is Haiku.
CHRONICLE_MODEL=claude-opus-5
CHRONICLE_EFFORT=high
CHRONICLE_MAX_TOKENS=16000
CHRONICLE_TIMEOUT_S=600
CHRONICLE_RESEARCH_MODEL=claude-haiku-4-5-20251001
CHRONICLE_RESEARCH_MAX_TOKENS=2000
CHRONICLE_RESEARCH_TIMEOUT_S=60
# A session touches a dozen subjects and the vector store answers one question
# at a time, so research fans out: one retrieval per resolved subject.
CHRONICLE_MAX_QUERIES=14
CHRONICLE_MAX_CONTEXT_BLOCKS=24
CHRONICLE_CONTEXT_CHARS=60000
CHRONICLE_MAX_NOTES_CHARS=120000
# Each art moment is a real image generation — the reason a draft takes
# minutes rather than seconds.
CHRONICLE_MAX_ART=6
CHRONICLE_DEFAULT_ART=3
# Draft chronicles and their images, before publishing. Runtime data.
CHRONICLE_DRAFT_DIR=/app/app-data/chronicle-drafts

# Overrides where the descriptions are read from. Normally unset — the file is
# read from the /site mount so DM edits apply without a rebuild, and from the
# copy inside the image if there is no mount.
# ART_DESCRIPTIONS_FILE=/site/chatbot/descriptions.json

# Legacy, and now effectively dead: a request that names no style gets the
# same default the Studio picker opens on (valley-scene). Setting this still
# overrides that default for callers that send no style — which is Enzo's
# /art command. Presets are defined in chatbot/vos/image_prompt_compiler.json
# (valley-portrait/scene/place, cinematic, illustrated, watercolor, ink,
# photoreal, sketch, stained-glass).
IMAGE_STYLE_PROMPT=

# Gallery persistence — defaults are usually fine.
# GALLERY_DIR=/app/generated-art        # location inside the chatbot container
GALLERY_MAX_ENTRIES=2000
GALLERY_PAGE_LIMIT=60

# ── Runtime safety / local dev ───────────────────────────────────────────────
# Comma-separated browser origins allowed to call /api. Leave blank for same
# origin production and permissive local dev.
ALLOWED_ORIGINS=

# Flask-Limiter syntax for /api/chat.
CHAT_RATE_LIMIT=30/hour;5/minute

# Reject oversized replayed browser chat history.
MAX_CONVERSATION_BYTES=60000

# Query expansion makes one small model call to improve retrieval. Set to 0 to
# reduce API usage.
QUERY_EXPANSION_ENABLED=1
QUERY_EXPANSION_CACHE_TTL=3600
QUERY_EXPANSION_CACHE_MAX=256

# The table's wall-clock timezone (IANA name). "Next session" and wiki date
# stamps key off this rather than UTC.
CAMPAIGN_TZ=America/Chicago

# Browser wiki edits and published lore trigger an async rebuild from inside
# the chatbot container. Site rebuild updates _site immediately; knowledge
# rebuild updates Enzo's corpus and hot-reloads workers on the next chat.
AUTO_REBUILD_ON_WIKI_SAVE=1
AUTO_KNOWLEDGE_ON_WIKI_SAVE=1
REBUILD_COMMAND_TIMEOUT_SECONDS=900
# Wiki saves debounce onto a trailing timer (an editing session is many small
# saves); knowledge rebuilds ride along at most once per interval. The DM's
# "Rebuild Now" bypasses both.
REBUILD_DEBOUNCE_SECONDS=90
REBUILD_KNOWLEDGE_MIN_INTERVAL_SECONDS=900
