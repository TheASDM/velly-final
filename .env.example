# ── Anthropic (Claude) ────────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Which Claude model to use.
# Default: claude-haiku-4-5-20251001
# Other options: claude-sonnet-4-6, claude-opus-4-6
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Ollama / Embeddings ──────────────────────────────────────────────────────
# URL for Ollama embeddings (include /ollama if behind OpenWebUI proxy)
OLLAMA_URL=https://ai.raptornet.dev/ollama

# Bearer token for Ollama/OpenWebUI authentication
OLLAMA_API_KEY=your_ollama_api_key_here

# ── DM Mode ──────────────────────────────────────────────────────────────────
# Passphrase typed into the chat to unlock DM mode (case-insensitive)
DM_PASSPHRASE=Prima Volta

# ── Embeddings ────────────────────────────────────────────────────────────────
# Must match the model used by build_vectors.py
EMBEDDING_MODEL=nomic-embed-text:latest

# ── Site display ──────────────────────────────────────────────────────────────
# When the next D&D session is scheduled. Surfaced as a chip in the top bar.
# Auto-hides the chip when the date has passed (end of local day).
# Date only:      NEXT_SESSION_DATE=2026-06-07     → "FRI JUN 7"
# Date + time:    NEXT_SESSION_DATE=2026-06-07T19:00 → "FRI JUN 7 · 7PM"
# Leave unset to hide the chip entirely.
# Rebuild the Eleventy site (`npm run build`) after changing this.
NEXT_SESSION_DATE=

# ── PWA runtime / push notifications ─────────────────────────────────────────
# One-file SQLite runtime state for subscriptions/messages/RSVPs.
APP_DB_PATH=/app/app-data/vallombrosa.sqlite3

# DM-only PWA actions (/dm test push now; messages/RSVP summary later).
# Use a long random value in production.
ADMIN_TOKEN=

# Optional player login. Set one variable per player so shell/Compose parsing
# never has to handle spaces, quotes, commas, or semicolons in character names.
# AUTH_TOKEN_SECRET should be a long random value; ADMIN_TOKEN is used as a
# fallback secret if this is left blank.
AUTH_TOKEN_SECRET=
PLAYER_CODE_CAR=
PLAYER_CODE_KRYTON=
PLAYER_CODE_LOTAN=
PLAYER_CODE_NONAME=
PLAYER_CODE_ORABELLA=
PLAYER_CODE_ROXY=
PLAYER_CODE_VALEN=
PLAYER_CODE_DUSTIN=

# VAPID key pair for Web Push. Public key is safe to ship to clients; private
# key must stay in server env. Generate a replacement with:
#   npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=BB824fQSj6QR9ajuVNf6SgPBCQ_l-zRmkTVphiXZUCo6iWvkxa7XtAsuMDdtWbzXsuqMTljCa1prcZtCMU0FCZA
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dm@valleyofshadows.wiki

# ── Art Studio (Tools → Art) ──────────────────────────────────────────────────
# Image generation is wired to OpenAI's images API. Required for the /art
# slash command in the chatbot AND for the standalone Tools/Art Studio page.
OPENAI_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=high
IMAGE_SIZE=1024x1024

# Legacy: used only by /art chat command when no style preset is chosen.
# The new Tools/Art page bypasses this in favor of named presets (valley,
# cinematic, illustrated, watercolor, ink, photoreal, sketch, stained-glass).
IMAGE_STYLE_PROMPT=

# Gallery persistence — defaults are usually fine.
# GALLERY_DIR=/app/generated-art        # location inside the chatbot container
# GALLERY_MAX_ENTRIES=2000              # FIFO trim above this many images
# GALLERY_PAGE_LIMIT=60                 # default page size for /api/gallery
